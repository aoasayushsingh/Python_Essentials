num_students = int(input("Enter the number of students in the class: "))

total_class_score = 0
total_tests_conducted = 0

for student_id in range(1, num_students + 1):
    print(f"\n--- Entering data for Student {student_id} ---")
    student_total_score = 0
    
    for test_id in range(1, 6):
        score = float(input(f"  Enter score for Test {test_id}: "))
        student_total_score += score
        total_class_score += score
        total_tests_conducted += 1
        
    student_average = student_total_score / 5
    print(f"=> Average score for Student {student_id}: {student_average:.2f}")
if num_students > 0:
    overall_class_average = total_class_score / total_tests_conducted
    print(f"Overall Class Average: {overall_class_average:.2f}")
else:
    print("\nNo student data was entered.")
